# ── Server ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL 14+; Neon works) ─────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blowmaggy
# Optional: Neon direct (non-pooled) URL, used only for migrations
# DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/blowmaggy?sslmode=require

# ── Auth ───────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-too-another-long-random-string-32-chars
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# ── Payments ───────────────────────────────────────
# mock     = offline demo gateway (no keys needed)
# razorpay = Razorpay TEST mode (UPI + card)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (pick one; if none set, emails are saved to ./tmp/emails) ─
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Blowmaggy <orders@blowmaggy.demo>

# ── Jobs ───────────────────────────────────────────
CRON_ENABLED=true
LOG_LEVEL=info
