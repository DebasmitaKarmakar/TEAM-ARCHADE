// BLOWMAGGY — The Everything Issue
// All money columns are INTEGER PAISE (₹1,499 = 149900).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SHOPPER
  DEPT_MANAGER
  SUPPORT
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  COD
}

enum CouponType {
  PERCENT
  FLAT
  FREE_DELIVERY
}

enum StockReason {
  SEED
  SALE
  RESTOCK
  CANCEL
  RETURN
  ADJUST
}

enum MemberPlan {
  MONTHLY
  YEARLY
}

// ───────────── Users & auth ─────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role                 @default(SHOPPER)
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  memberUntil         DateTime?
  memberPlan          MemberPlan?
  createdAt           DateTime             @default(now())
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  wishlist            WishlistItem[]
  reviews             Review[]
  reviewVotes         ReviewVote[]
  refreshTokens       RefreshToken[]
  views               ProductView[]
  notifications       Notification[]
  membershipPurchases MembershipPurchase[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  @@index([userId])
}

// ───────────── Catalog ─────────────

model Department {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  tagline    String
  accentHex  String
  accent2Hex String?
  sortOrder  Int
  isActive   Boolean    @default(true)
  categories Category[]
  products   Product[]
  managers   User[]
  coupons    Coupon[]
}

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  sortOrder    Int        @default(0)
  products     Product[]

  @@index([departmentId])
}

model Product {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  code         String                   @unique
  name         String
  brand        String
  description  String
  departmentId String
  department   Department               @relation(fields: [departmentId], references: [id])
  categoryId   String
  category     Category                 @relation(fields: [categoryId], references: [id])
  images       String[]
  attributes   Json                     @default("{}")
  tags         String[]
  basePrice    Int
  mrp          Int
  ratingSum    Int                      @default(0)
  ratingCount  Int                      @default(0)
  ratingAvg    Float                    @default(0)
  bayesScore   Float                    @default(0)
  soldCount    Int                      @default(0)
  isActive     Boolean                  @default(true)
  publicAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  /// Generated column (see migration 0002). Never written by Prisma.
  searchVector Unsupported("tsvector")?
  variants     Variant[]
  reviews      Review[]
  bundleItems  BundleItem[]
  wishlistedBy WishlistItem[]
  views        ProductView[]
  orderItems   OrderItem[]

  @@index([departmentId, isActive])
  @@index([categoryId])
  @@index([basePrice])
  @@index([bayesScore])
  @@index([createdAt])
  @@index([tags], type: Gin)
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

model Variant {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String          @unique
  options    Json
  price      Int
  mrp        Int
  stock      Int
  reserved   Int             @default(0)
  lowStockAt Int             @default(5)
  image      String?
  isActive   Boolean         @default(true)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  StockMovement[]

  @@index([productId])
  @@index([options(ops: JsonbPathOps)], type: Gin)
}

model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  variant   Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    StockReason
  refId     String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([variantId, createdAt])
}

// ───────────── Cart ─────────────

model Cart {
  id          String     @id @default(cuid())
  userId      String?    @unique
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId     String?    @unique
  couponCode  String?
  grocerySlot String?
  items       CartItem[]
  updatedAt   DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty        Int
  priceAtAdd Int
  addedAt    DateTime @default(now())

  @@unique([cartId, variantId])
}

// ───────────── Promotions ─────────────

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  description    String
  type           CouponType
  value          Int
  maxDiscount    Int?
  minCart        Int                @default(0)
  departmentId   String?
  department     Department?        @relation(fields: [departmentId], references: [id])
  firstOrderOnly Boolean            @default(false)
  membersOnly    Boolean            @default(false)
  usageLimit     Int?
  perUserLimit   Int                @default(1)
  usedCount      Int                @default(0)
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean            @default(true)
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

model Bundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  discountPct Int
  image       String?
  isActive    Boolean      @default(true)
  items       BundleItem[]
}

model BundleItem {
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

// ───────────── Orders ─────────────

model Order {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  status               OrderStatus       @default(PENDING_PAYMENT)
  addressSnapshot      Json
  subtotal             Int
  discountTotal        Int
  couponCode           String?
  couponDiscount       Int               @default(0)
  memberSavings        Int               @default(0)
  deliveryFee          Int
  tax                  Int
  total                Int
  paymentMethod        PaymentMethod
  idempotencyKey       String            @unique
  reservationExpiresAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  items                OrderItem[]
  shipments            Shipment[]
  events               OrderEvent[]
  payment              Payment?
  redemption           CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
}

model Shipment {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  group       String
  status      OrderStatus @default(PENDING_PAYMENT)
  slot        String?
  eta         DateTime
  trackingNo  String?
  deliveredAt DateTime?
  items       OrderItem[]

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId      String?
  shipment        Shipment?   @relation(fields: [shipmentId], references: [id])
  variantId       String
  variant         Variant     @relation(fields: [variantId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  departmentId    String
  nameSnapshot    String
  brandSnapshot   String
  optionsSnapshot Json
  imageSnapshot   String?
  unitPrice       Int
  qty             Int
  lineDiscount    Int         @default(0)
  lineTotal       Int
  status          OrderStatus @default(PENDING_PAYMENT)

  @@index([orderId])
  @@index([departmentId])
  @@index([productId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  method            PaymentMethod
  amount            Int
  refundedAmount    Int           @default(0)
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model MembershipPurchase {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              MemberPlan
  amount            Int
  provider          String
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())

  @@index([userId])
}

model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

// ───────────── Engagement ─────────────

model WishlistItem {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  priceWhenAdded Int
  createdAt      DateTime @default(now())

  @@id([userId, productId])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  body      String
  images    String[]
  verified  Boolean      @default(false)
  helpful   Int          @default(0)
  status    String       @default("PUBLISHED")
  createdAt DateTime     @default(now())
  votes     ReviewVote[]

  @@unique([productId, userId])
  @@index([productId, status, helpful])
}

model ReviewVote {
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([userId, viewedAt])
}

model CoPurchase {
  productA String
  productB String
  count    Int

  @@id([productA, productB])
  @@index([productA, count])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
