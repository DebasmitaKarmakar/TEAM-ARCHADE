# JWT
JWT_ACCESS_SECRET=change-me-to-32-random-bytes-min
JWT_REFRESH_SECRET=change-me-to-32-random-bytes-min-too
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Payment
PAYMENT_MODE=mock
